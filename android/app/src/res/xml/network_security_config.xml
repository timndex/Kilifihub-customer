<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) traffic to development and partner domains -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">unaux.com</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">*.safaricom.co.ke</domain>
        <domain includeSubdomains="true">10.0.3.2</domain>
    </domain-config>

    <!-- Default configuration: enforce HTTPS for all other connections -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
